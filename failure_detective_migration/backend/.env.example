# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
# Future hosted model key. Keep real keys in deployment secrets, never commit them.
GROQ_API_KEY=
# Optional persistent conversation memory. Use Supabase Project URL and service_role key.
# Never put the service_role key in frontend code or commit a real .env file.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase publishable/anon key used only to verify user access tokens server-side.
SUPABASE_ANON_KEY=
# Random secret of at least 32 characters used to sign guest session tokens.
GUEST_SESSION_SECRET=
